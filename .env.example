# Copy this file to `.env` and fill in your API keys.
# .env is in .gitignore — it will never be committed.
#
# FRED — required for all FRED-based workflows (briefing, status, etc.)
# Get a free FRED API key here: https://fred.stlouisfed.org/docs/api/api_key.html

FRED_API_KEY=

# Firecrawl — optional, required only for `--fetch-ism` (ISM PMI scraper).
# ISM data is not on FRED; we scrape ismworld.org press release pages.
# Free tier (500 credits/month) is more than enough — ~4 credits per refresh.
# Get a key here: https://www.firecrawl.dev/app/api-keys

FIRECRAWL_API_KEY=
